<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <!-- UniversalDocs: Strict 100% Offline & Hardware Keystore Policy -->
    <cloud-backup>
        <!-- Disallow all cloud backup -->
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <!-- Hardware-backed Keystore keys cannot transfer; exclude encrypted files and credentials -->
        <exclude domain="root" path="." />
        <exclude domain="file" path="UniversalDocs/Vault" />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>
